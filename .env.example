# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 채점·supervisor 결정성용(temperature=0 지원 모델). 비우면 OPENAI_MODEL로 폴백.
OPENAI_SUPERVISOR_MODEL=gpt-4.1-mini
OPENAI_VALUATION_MODEL=gpt-4.1-mini
# 최종 보고서·요약 작성 전용(서술 품질용). 비우면 OPENAI_MODEL로 폴백.
OPENAI_WRITING_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Search APIs
DART_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GNEWS_API_KEY=
SEARCH_QUERY_COUNT=4
NEWS_RESULTS_PER_QUERY=3
INDUSTRY_RAG_QUERY_COUNT=1
INDUSTRY_RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.5
SKAX_SEARCH_TIMEOUT_SECONDS=20
MAX_EVIDENCE_SEARCH_ROUNDS=4
FETCH_NEWS_FULL_TEXT=true

# Industry RAG pgvector
PGVECTOR_DATABASE_URL=postgresql://patentflow:patentflow@localhost:5432/patentflow
PGVECTOR_TABLE_NAME=industry_report_chunks

# Backend API
UNIFIED_API_BASE_URL=http://localhost:8080
UNIFIED_OPENAPI_SERVER_URL=http://127.0.0.1:8000

# Patent APIs
KIPRIS_API_KEY=

# LangSmith
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT=

# Tavily API
TAVILY_API_KEY=
