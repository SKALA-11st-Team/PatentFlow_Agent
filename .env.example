# =====================================================================
# LLM 설정 — 파이프라인 "역할(단계)"별로 묶음
#
# 각 역할의 노브:
#   *_MODEL              어떤 모델
#   *_REASONING_EFFORT   추론량(gpt-5 계열에만 적용). none|minimal|low|medium|high|xhigh
#   *_VERBOSITY          출력 상세도(gpt-5 계열에만 적용). low|medium|high
#   *_TIMEOUT_SECONDS    호출 제한시간(초)
#
# 폴백: MODEL 미설정→OPENAI_MODEL / REASONING·VERBOSITY 미설정→전역값→OpenAI기본 /
#       TIMEOUT 미설정→OPENAI_REQUEST_TIMEOUT_SECONDS(90초)
# =====================================================================
OPENAI_API_KEY=

# ── [공통/기본] 전용 설정이 없는 모든 호출(질의 재작성·근거 압축·뉴스 필터 등) ──
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal
# OPENAI_VERBOSITY=
OPENAI_REQUEST_TIMEOUT_SECONDS=90

# ── [Supervisor] 단계 감독 ──
OPENAI_SUPERVISOR_MODEL=gpt-5-mini
OPENAI_SUPERVISOR_REASONING_EFFORT=low

# ── [가치평가 4축] 권리성·기술성·시장성·사업연계성 채점 ──
OPENAI_VALUATION_MODEL=gpt-5
OPENAI_VALUATION_REASONING_EFFORT=medium
OPENAI_VALUATION_TIMEOUT_SECONDS=300

# ── [특허 구조화] patent_structuring (추출·청구항 분해; timeout은 가치평가와 공유) ──
OPENAI_STRUCTURING_MODEL=gpt-5-mini
OPENAI_STRUCTURING_REASONING_EFFORT=low
# 구조화 결과 디스크 캐시(artifacts/cache, run 간 영속). 같은 입력이면 LLM 재호출 생략. 기본 true.
STRUCTURING_CACHE_ENABLED=true

# ── [작성] 요약 + 최종 보고서 ──
OPENAI_WRITING_MODEL=gpt-5-mini
OPENAI_WRITING_REASONING_EFFORT=medium
OPENAI_WRITING_VERBOSITY=high
OPENAI_WRITING_TIMEOUT_SECONDS=240

# ── [임베딩] ──
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Search APIs
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GNEWS_API_KEY=
SEARCH_QUERY_COUNT=4
NEWS_RESULTS_PER_QUERY=3
INDUSTRY_RAG_QUERY_COUNT=1
INDUSTRY_RAG_TOP_K=3
COMPRESSION_WORKERS=8
# GNews 대체: 글로벌 뉴스를 Tavily(topic=news)로 수집. 최근 N일(뉴스 필터 5년과 정렬).
TAVILY_NEWS_MAX_AGE_DAYS=1825
# 수집 후 뉴스 recency 필터 최대 기간(일). naver·글로벌 공통. 낮추면 옛 기사 제외(예: 1095=3년, 730=2년)
NEWS_MAX_AGE_DAYS=1825
RAG_SCORE_THRESHOLD=0.45
SKAX_SEARCH_TIMEOUT_SECONDS=20
MAX_EVIDENCE_SEARCH_ROUNDS=3
FETCH_NEWS_FULL_TEXT=true

# Industry RAG pgvector
PGVECTOR_DATABASE_URL=postgresql://patentflow:patentflow@localhost:5432/patentflow
PGVECTOR_TABLE_NAME=industry_report_chunks

# Backend API
UNIFIED_API_BASE_URL=http://localhost:8080
UNIFIED_OPENAPI_SERVER_URL=http://127.0.0.1:8000

# Patent APIs
KIPRIS_API_KEY=

# LangSmith
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT=

# Tavily API
TAVILY_API_KEY=
