# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 채점·supervisor 결정성용(temperature=0 지원 모델). 비우면 OPENAI_MODEL로 폴백.
OPENAI_SUPERVISOR_MODEL=gpt-4.1-mini
OPENAI_VALUATION_MODEL=gpt-4.1-mini
# 최종 보고서·요약 작성 전용(서술 품질용). 비우면 OPENAI_MODEL로 폴백.
OPENAI_WRITING_MODEL=gpt-5
# GPT-5 추론량(effort)·상세도(verbosity). gpt-5 계열에만 적용. 비우면 API 기본값.
# effort: none|minimal|low|medium|high|xhigh, verbosity: low|medium|high
OPENAI_REASONING_EFFORT=minimal
OPENAI_VALUATION_REASONING_EFFORT=high
OPENAI_VALUATION_TIMEOUT_SECONDS=180
OPENAI_WRITING_REASONING_EFFORT=medium
OPENAI_WRITING_VERBOSITY=high
# 보고서/요약 작성은 출력이 길어 일반 호출(90s)보다 오래 걸리므로 별도 timeout
OPENAI_WRITING_TIMEOUT_SECONDS=240
OPENAI_SUPERVISOR_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Search APIs
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GNEWS_API_KEY=
SEARCH_QUERY_COUNT=4
NEWS_RESULTS_PER_QUERY=3
INDUSTRY_RAG_QUERY_COUNT=1
INDUSTRY_RAG_TOP_K=3
COMPRESSION_WORKERS=8
# GNews 대체: 글로벌 뉴스를 Tavily(topic=news)로 수집. 최근 N일(뉴스 필터 5년과 정렬).
TAVILY_NEWS_MAX_AGE_DAYS=1825
# 수집 후 뉴스 recency 필터 최대 기간(일). naver·글로벌 공통. 낮추면 옛 기사 제외(예: 1095=3년, 730=2년)
NEWS_MAX_AGE_DAYS=1825
RAG_SCORE_THRESHOLD=0.45
SKAX_SEARCH_TIMEOUT_SECONDS=20
MAX_EVIDENCE_SEARCH_ROUNDS=4
FETCH_NEWS_FULL_TEXT=true

# Industry RAG pgvector
PGVECTOR_DATABASE_URL=postgresql://patentflow:patentflow@localhost:5432/patentflow
PGVECTOR_TABLE_NAME=industry_report_chunks

# Backend API
UNIFIED_API_BASE_URL=http://localhost:8080
UNIFIED_OPENAPI_SERVER_URL=http://127.0.0.1:8000

# Patent APIs
KIPRIS_API_KEY=

# LangSmith
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT=

# Tavily API
TAVILY_API_KEY=
